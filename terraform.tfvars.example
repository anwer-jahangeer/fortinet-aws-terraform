aws_region        = "us-east-1"
availability_zone = "us-east-1a"

# Restrict these to your administrator and VPN-peer public addresses.
admin_ingress_cidrs = ["203.0.113.10/32"]
wan_ingress_cidrs   = ["0.0.0.0/0"]

# FortiGate lab username defaults to admin. Set the lab password locally.
# FortiManager and FortiAnalyzer initially require admin / <EC2 instance ID>;
# change both to your chosen lab password after their first login.
admin_password = "REPLACE_ME"
ssh_public_key = "ssh-rsa REPLACE_ME"

# Accept each Fortinet Marketplace subscription, then copy the AMI IDs for the
# selected region. Keep FortiManager/FortiAnalyzer at or above FortiGate version.
fortigate_ami_id    = "ami-REPLACE_ME"
fortimanager_ami_id = "ami-REPLACE_ME"
fortianalyzer_ami_id = "ami-REPLACE_ME"
