config system interface
    edit "port1"
        set vdom "root"
        set mode static
        set ip {{ port1_ip }} 255.255.255.0
        set allowaccess ping https ssh fgfm
        set role wan
        set alias "{{ site_name }}-ISP1-MGMT"
        set description "AWS ISP1 underlay and private management"
    next
    edit "port2"
        set vdom "root"
        set mode static
        set ip {{ port2_ip }} 255.255.255.0
        set allowaccess ping
        set role lan
        set alias "{{ site_name }}-LAN"
        set description "AWS protected LAN"
    next
    edit "port3"
        set vdom "root"
        set mode static
        set ip {{ port3_ip }} 255.255.255.0
        set allowaccess ping
        set role wan
        set alias "{{ site_name }}-ISP2"
        set description "AWS ISP2 underlay"
    next
    edit "port4"
        set vdom "root"
        set mode static
        set ip {{ port4_ip }} 255.255.255.0
        set allowaccess ping
        set role wan
        set alias "{{ site_name }}-MPLS"
        set description "AWS private MPLS underlay"
    next
end

config router static
    edit 10
        set dst 0.0.0.0 0.0.0.0
        set gateway {{ port1_gateway }}
        set device "port1"
        set distance 10
        set priority 10
        set comment "ISP1 primary default via Debian"
    next
    edit 20
        set dst 0.0.0.0 0.0.0.0
        set gateway {{ port3_gateway }}
        set device "port3"
        set distance 20
        set priority 10
        set comment "ISP2 backup default via Debian"
    next
    edit 100
        set dst 10.10.252.0 255.255.255.0
        set gateway {{ port1_gateway }}
        set device "port1"
        set distance 5
        set priority 1
        set comment "Jumpbox and test-VM management"
    next
end
